__pycache__/
*.pyc
.pytest_cache/
.DS_Store
# The public workspace surface is an allowlist. Project handoffs, reusable
# tools, and canonical release recipes are tracked; releases, source drops,
# authoring material, drill runs, mentor studies, and other local work stay on
# the machine that owns them.
workspace/*
!workspace/tools/
!workspace/release-recipes/
!workspace/handoffs/

# Agent scratch space
tmp/
